# Salin berkas ini menjadi .env, lalu sesuaikan bagian "Mesin OCR".
#
# config.py TIDAK punya nilai default - semua kunci di bawah wajib ada di .env.
# Hanya kunci bertanda "boleh kosong" yang aman dikosongkan.
#
# Kunci yang hilang membuat config.py gagal saat diimpor, dengan error yang TIDAK
# menyebut nama variabelnya (TypeError dari int(None), atau AttributeError dari
# None.lower()) - lihat traceback untuk menemukan barisnya.
#
# Nilai boolean: hanya "true" (huruf besar/kecil bebas) yang dianggap nyala.
# Nilai lain, termasuk salah ketik seperti "ture", diam-diam dianggap false.
#
# Jebakan: path Windows JANGAN dikutip ganda.
#    python-dotenv memproses escape sequence di dalam kutip ganda, sehingga
#    "C:\Tesseract-OCR\tessdata" membuat \t menjadi TAB dan path-nya rusak
#    tanpa pesan error. Tulis tanpa kutip, atau pakai kutip tunggal.

# === Service ===
OCR_LOG_LEVEL=INFO
OCR_SERVICE_NAME=ocr-engine
OCR_SERVICE_VERSION=0.1.0
OCR_ENVIRONMENT=local
OCR_HOST=127.0.0.1
OCR_PORT=8082

# Ambang rata-rata karakter per halaman untuk menilai text layer PDF layak
# dipakai. Di bawah ini, dokumen dilempar ke jalur OCR (D-10).
OCR_TEXT_LAYER_MIN_CHARS=50

# === Preprocessing ===
PREPROCESS_DESKEW=true
PREPROCESS_DENOISE=true
PREPROCESS_PERSPECTIVE=true
# Dimatikan: Tesseract membinarisasi sendiri, dan pada fixture uji adaptive
# threshold kita justru membuat huruf tebal berongga. Uji ulang dengan dokumen asli.
PREPROCESS_THRESHOLD=false
PREPROCESS_UPSCALE_DPI=300
PREPROCESS_MORPHOLOGY=false

# === PDF ===
# Resolusi render halaman PDF yang tidak punya text layer.
PDF_RASTER_DPI=300
PDF_MAX_PAGES=15

# === Mesin OCR ===
# Harus salah satu nama yang terdaftar di OcrEngineFactory.get_available().
OCR_ENGINE=tesseract
TESSERACT_LANG=ind

# Boleh kosong. Kosong berarti pakai jalur bawaan instalasi Tesseract.
# Windows : C:\Program Files\Tesseract-OCR\tessdata
# Linux   : /usr/share/tesseract-ocr/5/tessdata
TESSERACT_DATA_PREFIX=

# Boleh kosong. Kosong berarti cari binary "tesseract" lewat PATH.
# Isi bila PATH tidak dapat diandalkan (service, scheduler, shell lama).
# Windows : C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux   : /usr/bin/tesseract
TESSERACT_CMD=
